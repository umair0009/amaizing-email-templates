{
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": [
    "src/templates/amaizing/**/*.html",
    "*.templates.json",
    "**/node_modules",
    "**/dist",
    "**/build",
    "**/.parcel-cache",
    "**/coverage",
    "**/docs"
  ]
}
