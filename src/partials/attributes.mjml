<mj-attributes>
  <mj-all font-family="'F37Bolton', Arial, sans-serif" />
  <mj-text
    padding="0"
    color="#344054"
    font-size="16px"
    line-height="24px"
    font-weight="300"
    font-family="'F37Bolton', Arial, sans-serif"
  />
  <mj-button
    background-color="#088AB2"
    color="white"
    font-size="16px"
    font-weight="600"
    border-radius="8px"
    height="44px"
    font-family="'F37Bolton', Arial, sans-serif"
  />
</mj-attributes>

<mj-html-attributes>
  <mj-selector path="p">
    <mj-html-attribute name="style">margin: 0;</mj-html-attribute>
  </mj-selector>
</mj-html-attributes>
